# Šablona. Zkopírujte ji a doplňte hodnoty:
#
#     cp .env.example .env.local
#
# Čte se POUZE .env.local (server.mjs i Vite). Je v .gitignore — nikdy ho necommitujte.
# Tento soubor (.env.example) se commituje, a proto v něm nesmí být žádné klíče.

# ---------------------------------------------------------------------------
# Google Maps — DVA různé klíče, každý s jiným omezením.
# V Google Cloud Console povolte: Maps JavaScript API + Places API.
# ---------------------------------------------------------------------------

# Prohlížečový klíč. Vrací ho /api/config/maps za běhu.
# Omezení: HTTP referrers (vaše doména + localhost:5173), API: pouze Maps JavaScript.
GOOGLE_MAPS_API_KEY=

# Serverový klíč pro Places (Nearby / Details / Text Search).
# Omezení: API pouze Places. Nesmí ho vrátit žádný endpoint.
# Když chybí, Places se degradují na mock data — nikdy se nepoužije klíč výše.
GOOGLE_MAPS_SERVER_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY záměrně NENASTAVUJTE.
# Vite ho zapéká přímo do JS bundlu, takže by se klíč dostal do dist/ a rotace
# by vyžadovala nový build. Prohlížeč si klíč vyzvedne z /api/config/maps.

# ---------------------------------------------------------------------------
# Supabase (volitelné — bez něj běží aplikace lokálně)
# service_role klíč sem NIKDY nedávejte, stačí anon / public.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Developer Mode — přepínač rolí v profilu. V ostré verzi nechte prázdné.
# ---------------------------------------------------------------------------
VITE_ENABLE_DEV_ROLE_SWITCH=
