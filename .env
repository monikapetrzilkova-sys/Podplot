# Google Maps JavaScript API + Places API
# Server čte GOOGLE_MAPS_API_KEY (nebo VITE_GOOGLE_MAPS_API_KEY) z tohoto souboru / OS env.
# V Google Cloud Console povolte: Maps JavaScript API + Places API.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Volitelně Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Developer Mode
VITE_ENABLE_DEV_ROLE_SWITCH=
