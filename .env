# Google Maps JavaScript API + Places API
# Server čte GOOGLE_MAPS_API_KEY (nebo VITE_GOOGLE_MAPS_API_KEY) z tohoto souboru / OS env.
# V Google Cloud Console povolte: Maps JavaScript API + Places API.
# Pro mobil přes LAN (http://192.168.x.x:5173) přidejte do omezení klíče HTTP referrer:
#   http://localhost:5173/*
#   http://127.0.0.1:5173/*
#   http://192.168.*.*:5173/*
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Volitelně Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Developer Mode — přepínač rolí v profilu
VITE_ENABLE_DEV_ROLE_SWITCH=
